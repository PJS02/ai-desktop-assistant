{
    "name": "URL Bridge",
    "description": "Send active tab URL to localhost HTTP receiver.",
    "version": "0.1.0",
    "manifest_version": 3,
    "permissions": [
        "tabs"
    ],
    "host_permissions": [
        "http://127.0.0.1:8765/*",
        "http://localhost:8765/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "URL Bridge"
    }
}